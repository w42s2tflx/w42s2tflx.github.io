constexpr</span> <span class="hljs-params">(<span class="hljs-keyword">requires</span> &#123; x.first, x.second; &#125;)</span></span><br><span class="hljs-function">        cerr &lt;&lt; &quot;<span class="hljs-params">(<span class="hljs-string">&quot;, _dbg(x.first), cerr &lt;&lt; &quot;</span>, <span class="hljs-string">&quot;, _dbg(x.second), cerr &lt;&lt; &quot;</span>)</span>&quot;</span>;<br>    <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> <span class="hljs-built_in">constexpr</span> (<span class="hljs-keyword">requires</span> &#123; x.<span class="hljs-built_in">begin</span>(), x.<span class="hljs-built_in">end</span>(); &#125; &amp;&amp;<br>                       !is_same_v&lt;T, string&gt;) &#123;<br>        <span class="hljs-type">bool</span> f = <span class="hljs-number">1</span>;<br>        <span class="hljs-keyword">constexpr</span> <span class="hljs-type">bool</span> m = <span class="hljs-keyword">requires</span> &#123; <span class="hljs-keyword">typename</span> T::mapped_type; &#125;;<br>        cerr &lt;&lt; (m ? <span class="hljs-string">&quot;&#123;&quot;</span> : <span class="hljs-string">&quot;[&quot;</span>);<br>        <span class="hljs-keyword">for</span> (<span class="hljs-keyword">auto</span>&amp;&amp; e : x)<br>            <span class="hljs-function"><span class="hljs-keyword">if</span> <span class="hljs-title">constexpr</span> <span class="hljs-params">(m)</span></span><br><span class="hljs-function">                cerr &lt;&lt; SEP &lt;&lt; e.first &lt;&lt; &quot;: <span class="hljs-string">&quot;, _dbg(e.second);</span></span><br><span class="hljs-string"><span class="hljs-function">            else</span></span><br><span class="hljs-string"><span class="hljs-function">                cerr &lt;&lt; SEP, _dbg(e);</span></span><br><span class="hljs-string"><span class="hljs-function">        cerr &lt;&lt; (m ? &quot;</span>&#125;<span class="hljs-string">&quot; : &quot;</span>]<span class="hljs-string">&quot;);</span></span><br><span class="hljs-string"><span class="hljs-function">    &#125; else</span></span><br><span class="hljs-string"><span class="hljs-function">        cerr &lt;&lt; x;</span></span><br><span class="hljs-string"><span class="hljs-function">&#125;</span></span><br><span class="hljs-string"><span class="hljs-function">template &lt;class... T&gt;</span></span><br><span class="hljs-string"><span class="hljs-function">void _p(const T&amp;... x) &#123;</span></span><br><span class="hljs-string"><span class="hljs-function">    bool f = 1;</span></span><br><span class="hljs-string"><span class="hljs-function">    ((cerr &lt;&lt; SEP, _dbg(x)), ...);</span></span><br><span class="hljs-string"><span class="hljs-function">    cerr &lt;&lt; &quot;</span>\n<span class="hljs-string">&quot;;</span></span><br><span class="hljs-string"><span class="hljs-function">&#125;</span></span><br><span class="hljs-string"><span class="hljs-function">#define dbg(...) (cerr &lt;&lt; #__VA_ARGS__ &lt;&lt; &quot;</span> =</span> <span class="hljs-string">&quot;, _p(__VA_ARGS__))</span><br><span class="hljs-string"></span><br><span class="hljs-string">void solve() &#123;</span><br><span class="hljs-string">    </span><br><span class="hljs-string">&#125;</span><br><span class="hljs-string"></span><br><span class="hljs-string">signed main() &#123;</span><br><span class="hljs-string">    ios::sync_with_stdio(false), cin.tie(nullptr);</span><br><span class="hljs-string">    int T = 1;</span><br><span class="hljs-string">    // cin &gt;&gt; T;</span><br><span class="hljs-string">    while (T--) solve();</span><br><span class="hljs-string">    return 0;</span><br><span class="hljs-string">&#125;</span><br></code></pre></td></tr></table></figure>]]></content>
    
    
    
